# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# Supabase project (Settings > API). The publishable/anon key is safe to expose
# to browsers; all data access is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Google Gemini API key for the AI support assistant (server-side only).
# Enable billing on the Google project for production use.
GEMINI_API_KEY=

# Optional override
# GEMINI_MODEL=gemini-3.5-flash
